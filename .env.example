# =============================================================
# CARRERAS HOT WHEELS — ALANBREX
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env a GitHub.
# =============================================================

# --- Servidor -------------------------------------------------
# En Hostinger el panel inyecta PORT automáticamente; no lo fijes en producción.
PORT=4000
NODE_ENV=development

# --- Base de datos MySQL (credenciales de hPanel) -------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=usuario_mysql
DB_PASSWORD=contraseña_mysql
DB_NAME=carreras_hw
DB_CONNECTION_LIMIT=5

# --- Sesión administrativa ------------------------------------
SESSION_TTL_HOURS=12

# --- Reglas de negocio ----------------------------------------
# Minutos hasta que expira una solicitud de inscripción sin pago confirmado.
RESERVATION_EXPIRY_MINUTES=30
# Número de WhatsApp del negocio (formato internacional sin + ni espacios)
WHATSAPP_NUMBER=5910000000000
# Precio de la inscripción (se sugiere en el mensaje de WhatsApp)
ENTRY_PRICE=100

# --- Seguridad ------------------------------------------------
# true SOLO si el sitio se sirve por HTTPS (recomendado en producción).
COOKIE_SECURE=false
# Ejecuta migraciones pendientes al arrancar la app (útil si no hay SSH en el hosting).
AUTO_MIGRATE=false

# --- Limitación de solicitudes --------------------------------
RATE_WINDOW_MS=60000
RATE_LOGIN_MAX=8
RATE_RESERVATION_MAX=20
